{
  "skipDangerousModePermissionPrompt": true,
  "skipDevelopmentChannelPrompt": true,
  "acceptedDevelopmentChannels": [
    "server:space-channel"
  ],
  "permissions": {
    "allow": [
      "mcp__spacenotes-mcp__*",
      "mcp__space-channel__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/space-channel-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/space-channel-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/space-channel-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/space-channel-hook.sh"
          }
        ]
      }
    ]
  }
}
